{
  "name": "sillwalker",
  "productName": "Sillwalker",
  "version": "0.1.1",
  "description": "Sillwalker, un idle RPG qui vit en bas de ton écran.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "trace": "electron . --trace=10",
    "fontbench": "electron . --font-bench",
    "dev": "electron . --dev-tools",
    "test": "node scripts/check-syntax.mjs && node scripts/check-imports.mjs && node scripts/check-comments.mjs && node --experimental-default-type=module scripts/i18n-quotes.mjs && node --experimental-default-type=module scripts/i18n-check-all.mjs && node --experimental-default-type=module scripts/steam-achievements.mjs --check && node --experimental-default-type=module scripts/steam-richpresence.mjs --check && node --experimental-default-type=module scripts/test-logic.js",
    "perf": "electron . --perf --ghost --user-data=./dev-data",
    "icons": "node --experimental-default-type=module scripts/make-icons.js",
    "dist": "electron-builder --win dir",
    "steam:build": "node scripts/steam-upload.mjs",
    "dist:itch": "electron-builder --win dir zip -c.extraMetadata.distribution=itch -c.directories.output=dist-itch",
    "dist:itch:linux": "electron-builder --linux tar.gz -c.extraMetadata.distribution=itch -c.directories.output=dist-itch",
    "dist:itch:appimage": "electron-builder --linux AppImage -c.extraMetadata.distribution=itch -c.directories.output=dist-itch",
    "dist:itch:mac": "electron-builder --mac zip -c.extraMetadata.distribution=itch -c.directories.output=dist-itch",
    "dist:zip": "electron-builder --win zip",
    "selftest": "node scripts/selftest.mjs",
    "selftest:linux": "node scripts/selftest.mjs --linux",
    "perf:linux": "xvfb-run -a -s \"-screen 0 1920x1080x24\" electron . --perf --ghost --no-sandbox --user-data=./dev-data"
  },
  "dependencies": {
    "steamworks.js": "0.4.0"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "5.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "author": "Victor Basset",
  "build": {
    "appId": "com.sillwalker.game",
    "productName": "Sillwalker",
    "copyright": "© 2026 Sillwalker",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "src/**/*",
      "assets/**/*",
      "!node_modules/steamworks.js/dist/{linux64,osx}/**",
      "!node_modules/steamworks.js/dist/win64/*.lib",
      "!**/*.{md,d.ts,map}",
      "!node_modules/@types/**",
      "!node_modules/undici-types/**",
      "!src/main/selftest.js",
      "!src/main/perf.js",
      "!src/main/trace.js",
      "!src/renderer/dev/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/steamworks.js/dist/win64/**"
    ],
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Sillwalker"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "linux": {
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "Sillwalker-${version}-linux.${ext}"
    },
    "mac": {
      "category": "public.app-category.role-playing-games",
      "icon": "build/icon.png",
      "artifactName": "Sillwalker-${version}-mac.${ext}",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  }
}
